# ─── Application ─────────────────────────────────────────────────────────────

# Environment: "development" | "production" | "test"
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection URL (async driver)
DATABASE_URL=postgresql+asyncpg://peblo:peblo_secret@localhost:5432/peblo_tv

# ─── Auth ─────────────────────────────────────────────────────────────────────

# JWT secret — use `openssl rand -hex 32` in production, NEVER commit the real value
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Storage ─────────────────────────────────────────────────────────────────

# "local" for development, "r2" for Cloudflare R2 in production
STORAGE_BACKEND=local

# Local storage: absolute or relative path on the server filesystem
LOCAL_STORAGE_PATH=./storage

# Public base URL used to build artwork URLs returned in API responses
# In local dev this points to the FastAPI static files mount
LOCAL_STORAGE_BASE_URL=http://localhost:8000/storage

# Cloudflare R2 — only required when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Catalogue ────────────────────────────────────────────────────────────────

# Directory where the published catalogue.json lives (inside the container/server)
CATALOGUE_DIR=./catalogue

# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins
# In production, set these to your actual domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Frontend ────────────────────────────────────────────────────────────────

# CMS — API base URL used inside the CMS (set in cms/.env)
# VITE_API_BASE_URL=http://localhost:8000

# Viewer — Catalog API base URL used inside the Viewer (set in viewer/.env)
# VITE_CATALOG_API_URL=http://localhost:8000
