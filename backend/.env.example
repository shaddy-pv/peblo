# ─── Peblo Backend Environment Configuration ─────────────────────────────────

ENVIRONMENT=development

# PostgreSQL connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://peblo:peblo_secret@localhost:5432/peblo_tv

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=dev_secret_key_please_change_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage: "local" or "r2"
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_BASE_URL=http://localhost:8000/storage

# Cloudflare R2 Settings (when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Catalogue output directory
CATALOGUE_DIR=./catalogue

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
